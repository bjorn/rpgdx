#!/bin/bash
# Installed at /home/private/rpgdx/.git/hooks/post-receive on the NFS host.
# Runs after `git push live master:master`; rsyncs the worktree to /home/public.
set -euo pipefail

REPO="/home/private/rpgdx"
WWW_DATA="/home/public"

cd "$REPO" || exit 1

echo "Synchronizing website at $WWW_DATA"

# Receiver-only filters protect configuration and runtime data from deletion.
# Delete other destination-only and repository-excluded files after transfer so
# retired code cannot linger in the public directory.
# Include access rules before hiding dotfiles and protecting runtime contents.
rsync -rtv --delete-after --delete-excluded \
	--include=".htaccess" \
	--filter="protect /wiki" \
	--filter="protect /.htaccess_forwards" \
	--filter="protect /.well-known/acme-challenge/***" \
	--filter="protect /forums/config.php" \
	--filter="protect /forums/cache/***" \
	--filter="protect /forums/files/***" \
	--filter="protect /forums/store/***" \
	--filter="protect /forums/images/avatars/upload/***" \
	--filter="protect /uploads/***" \
	--filter="protect /forums/images/avatars/*.gif" \
	--filter="protect /forums/images/avatars/*.jpg" \
	--filter="protect /forums/images/avatars/*.png" \
	--filter="protect /images/guicomp/*.png" \
	--filter="protect /images/tablet.png" \
	--filter="protect /images/sponge.jpg" \
	--filter="protect /images/sourcesecure-120x90.gif" \
	--filter="protect /templates/modern/images/rpgdx_banner.png" \
	--exclude=".*" \
	--exclude "/*.md" \
	--exclude "/HOSTED" \
	--exclude "/TODO" \
	--exclude "/rpgdx.code-workspace" \
	--exclude "/sql/" \
	--exclude "/install/" \
	--exclude "/forums/install/" \
	--exclude "/docker/" \
	--exclude "/docker-compose*.yml" \
	--exclude "/docker-compose*.yaml" \
	--exclude "/deploy/" \
	--exclude "/tools/" \
	--exclude "/scripts/" \
	--exclude "/tests/" \
	--exclude "/forums/config.php" \
	--exclude "/forums/cache/*" \
	--exclude "/forums/files/*" \
	--exclude "/forums/store/*" \
	--exclude "/forums/images/avatars/upload/*" \
	--exclude "/uploads/*" \
	./ "$WWW_DATA"

echo "Website deployed!"
